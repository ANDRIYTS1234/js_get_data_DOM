var numbers = document.querySelectorAll('.population');
var result = [];
numbers.forEach(function(item) {
    var num = item.textContent.split(',').join('');
    result.push(Number(num));
});
var totalSum = result.reduce(function(prev, cur) {
    return prev + cur;
}, 0);
var average = totalSum / result.length;
var totalElement = document.querySelector('span.total-population');
var averageElement = document.querySelector('span.average-population');
totalElement.textContent = totalSum.toLocaleString('en-US');
averageElement.textContent = average.toLocaleString('en-US');

